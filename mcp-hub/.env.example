# mcp-hub 配置模板
#
# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略）：cp .env.example .env
# 全部配置项可运行 `mcp-hub env` 查看。
# 优先级：进程环境变量 > .env > 内置默认值。
# 容器（docker compose）不读本文件：MCPHUB_DB / MCPHUB_CACHE / MCPHUB_ADDR 由 docker-compose.yml 的 environment 注入（主机名是服务名）。详见仓库根 docs/deployment.md。
# 查找顺序：$MCPHUB_ENV_FILE → ./.env → 可执行文件旁的 .env，只加载第一个命中的。
# 桌面形态以应用数据目录下的 .env 为锚点，不回退到当前工作目录。
# 名字写错会在启动时被点名提醒；值为空（MCPHUB_ADDR=）等于没写，用内置默认值。

# 配置文件
# 显式指定配置文件路径；只能来自进程环境变量。
# MCPHUB_ENV_FILE=/etc/mcp-hub/mcphub.env

# 数据库（留空即零配置 SQLite）
# postgres://... → PostgreSQL（pgvector 走原生向量路径）
# 文件路径      → SQLite（纯 Go，无需 CGO）
# 留空 = 在当前目录（桌面形态为应用数据目录）建 mcp-hub.db
# 切换后端不迁移数据；表结构首次连接自动同步，PG 需先建空库。
#MCPHUB_DB=postgres://mcphub:mcphub@127.0.0.1:5432/mcphub?sslmode=disable

# 后端类型：auto | postgres | sqlite（默认 auto，按连接串形态推断）
#MCPHUB_DB_DRIVER=auto

# 服务
# 监听地址；":9090" 表示全部网卡，管理接口可增删下游，本机开发请写 127.0.0.1
MCPHUB_ADDR=127.0.0.1:9090

# 缓存后端：redis://127.0.0.1:6379/0 走 Redis；留空走进程内缓存（16 分片 + TTL + 后台回收）
# 多实例部署必须用 Redis（内存缓存不跨进程）；指定 redis:// 却连不上会启动失败，不降级
#MCPHUB_CACHE=redis://127.0.0.1:6379/0

# 缓存类型：auto | redis | memory（默认 auto，按连接串形态推断）
#MCPHUB_CACHE_DRIVER=auto

# debug | info | warn | error
MCPHUB_LOG_LEVEL=info

# tools/list 返回 meta（只列 5 个检索工具）或 all（全量）
MCPHUB_LIST_MODE=meta

# 周期探活间隔，0 关闭；决定下游恢复后多久自动生效
MCPHUB_PROBE_INTERVAL=45s

# 启动时先探活一轮再对外服务
MCPHUB_PROBE_ON_START=true

# 同一上游连续探活失败达到该次数后暂停其工具调用；探活照常，恢复后自动解除；0 不拦截
MCPHUB_PROBE_BLOCK_AFTER=3

# 是否暴露旧版 SSE 端点
MCPHUB_SSE=true

# gin 运行模式：debug | release | test（GIN_MODE 同义，本项优先）；debug 会向 stdout 打中间件提示
MCPHUB_GIN_MODE=release

# 管理接口鉴权密钥；留空不校验，仅建议监听 127.0.0.1 时留空
# MCPHUB_API_KEY=

# Embedding（工具检索的向量一路）
# OpenAI 兼容的 /v1/embeddings 地址，换服务商只改 BASE_URL
MCPHUB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
MCPHUB_EMBED_MODEL=BAAI/bge-m3

# 向量维度，必须与模型实际输出一致；写库前的维度校验会拦住，否则检索静默降级
MCPHUB_EMBED_DIMS=1024

# 每批送多少条文本给 embed 接口
MCPHUB_EMBED_BATCH_SIZE=64

# 进向量语料的字段，逗号分隔；all（或不写）表示五项全开
# 可选：toolName / toolDescription / tags / serverDescription / schemaHints
# 与 MODEL、DIMS 一起构成"一代"向量的身份，修改会触发整代重建
MCPHUB_CORPUS_FIELDS=all

# 密钥；留空则检索自动降级为 bm25，网关照常运行
MCPHUB_EMBED_API_KEY=

# Reranker（hybrid 检索的精排一路）
# 留空 MCPHUB_RERANK_MODEL 即关闭精排，返回 RRF 融合排序
MCPHUB_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 与 embed 同源时可省，自动复用上面的地址与密钥
# MCPHUB_RERANK_BASE_URL=
# MCPHUB_RERANK_API_KEY=
