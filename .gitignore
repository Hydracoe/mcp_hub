# 编译产物
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go 测试与覆盖率
*.test
*.out
coverage.txt
coverage.html

# Go 工作区文件
go.work
go.work.sum

# 依赖（默认不提交，需要离线构建时由 make vendor 生成）
/vendor/

# 日志与 make dev 的运行时文件（日志/pid）
*.log
/logs/

# 本地环境变量与密钥
.env
.env.*
# 模板要先忽略再放行：上面的 .env.* 会连 .env.example 一起挡掉，
# 而模板恰恰是唯一该进版本库的那个（Config as Documentation）。
!.env.example

# macOS
.DS_Store

# 编辑器与 IDE
.idea/
*.swp
*.swo
*~
.codegraph/