# 根级忽略规则：子目录各自的 .gitignore 仍然生效，这里只补根目录与仓库级文件。

# ─── 本地环境变量与真实凭据 ──────────────────────────────────────
.env
.env.*
# 模板要放行：上面的 .env.* 会连 .env.example 一起挡掉
!.env.example

# ─── 构建产物与运行时文件 ────────────────────────────────────────
/mcp-hub/bin/
/mcp-hub/logs/
/mcp-hub-admin/node_modules/
/mcp-hub-admin/dist/
*.log

# ─── macOS ──────────────────────────────────────────────────────
.DS_Store

# ─── 编辑器与 IDE ────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── 代码索引 ────────────────────────────────────────────────────
.codegraph/

# ─── 合并 monorepo 时归档的旧仓库（保留备份，不提交）───────────
/.git-archive/
