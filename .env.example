# mcp-hub 配置模板
#
# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会进版本库）：
#     cp .env.example .env
#
# 全部可配置项也可以直接跑 `mcp-hub env` 查看。
#
# 配置只有这一个来源：管理界面上没有配置入口，库里也不存配置。
# 改配置 = 改这个文件 + 重启，不存在"界面改完被重启打回"的情况。
#
# 优先级：进程环境变量 > .env > 内置默认值。
# 也就是说 `MCPHUB_ADDR=:8080 mcp-hub serve` 会覆盖本文件里的值，
# 容器 / K8s 注入的变量同理 —— 部署参数永远赢过这个文件。
#
# 注意：容器部署（docker compose）根本不读这个文件。容器里的
# MCPHUB_DB / MCPHUB_CACHE / MCPHUB_ADDR 由 docker-compose.yml 的
# environment 注入，因为容器有自己的网络拓扑（主机名是服务名，
# 不是 127.0.0.1）。在这里改完发现容器行为没变，原因就在这。
# 见 docs/deployment.md。
#
# 本文件的查找顺序：$MCPHUB_ENV_FILE → ./.env → 可执行文件旁的 .env，
# 只加载第一个命中的。桌面形态（mcp-hub-desktop）额外把应用数据目录下的
# .env 作为锚点，且**不回退**到当前工作目录 —— 否则站在仓库里启动一个
# 零配置应用，会读到仓库的开发用 .env 去连并不存在的 PostgreSQL。
# 这里的名字写错了会在启动时被点名提醒。
# 值为空（MCPHUB_ADDR=）等于没写，用内置默认值。

# ─── 配置文件 ─────────────────────────────────────────────────
# 显式指定配置文件路径；只能来自进程环境变量（它决定去哪找配置，
# 不能反过来由配置决定）。默认依次找 ./.env 与可执行文件旁的 .env。
# MCPHUB_ENV_FILE=/etc/mcp-hub/mcphub.env

# ─── 数据库（可选，留空即零配置）───────────────────────────────
#
# 两种后端，用哪个由 MCPHUB_DB 的形态或 MCPHUB_DB_DRIVER 显式指定：
#
#   postgres://...    PostgreSQL（自带 pgvector 时向量检索走原生路径）
#   /path/to/x.db     文件路径 → SQLite（纯 Go 实现，无需 CGO）
#
# 留空 = 在当前目录（桌面形态下是系统应用数据目录）建 mcp-hub.db 走 SQLite。
# 这是默认，所以"想先跑起来看看"不必先起数据库。
#
# 切换后端不需要改代码，但两边的数据互不相通：PostgreSQL 里的配置
# 不会自动出现在 SQLite 库里。表结构在首次连接时自动同步，PG 需先建好空库；
# 自带 pgvector 扩展的镜像见项目根的 docker-compose.yml。
#MCPHUB_DB=postgres://mcphub:mcphub@127.0.0.1:5432/mcphub?sslmode=disable

# 后端类型：auto | postgres | sqlite（默认 auto，按上面的连接串形态推断）。
# 只有一种情况需要显式指定：库文件放在一个不像路径的位置。
#MCPHUB_DB_DRIVER=auto

# ─── 服务 ─────────────────────────────────────────────────────
# 监听地址。只写 ":9090" 等于监听**全部网卡**，而管理接口能增删下游
# server，等于半个 shell —— 本机开发请显式写 127.0.0.1。
MCPHUB_ADDR=127.0.0.1:9090

# 缓存后端（可选，留空即零配置）：Redis 或进程内缓存。
#
#   redis://127.0.0.1:6379/0   Redis，多实例共享
#   留空                        进程内缓存（16 分片 + TTL + 后台回收）
#
# 单机部署用内存缓存完全可以。多实例部署必须用 Redis：内存缓存不跨进程，
# 每个实例各说各话（各自探活、各自算检索缓存），启动时会有一条 warn 提醒。
# 指定了 redis:// 却连不上会直接启动失败，不静默降级。
#MCPHUB_CACHE=redis://127.0.0.1:6379/0

# 缓存类型：auto | redis | memory（默认 auto，按上面的连接串形态推断）。
#MCPHUB_CACHE_DRIVER=auto

# debug | info | warn | error
MCPHUB_LOG_LEVEL=info

# tools/list 返回什么：meta（只列 5 个检索工具，PRD §4.7.6）或 all（全量）
MCPHUB_LIST_MODE=meta

# 周期探活间隔，0 关闭。它决定"下游恢复了"多久自动生效。
MCPHUB_PROBE_INTERVAL=45s

# 启动时先探活一轮再对外服务
MCPHUB_PROBE_ON_START=true

# 同一上游连续探活失败达到该次数后，网关暂停它的工具调用
# （AI 调用会收到明确的拦截说明；探活照常，恢复后自动解除）。0 不拦截。
MCPHUB_PROBE_BLOCK_AFTER=3

# 是否暴露旧版 SSE 端点（老客户端用）
MCPHUB_SSE=true

# HTTP 框架（gin）运行模式：debug | release | test。
# gin 自己的 GIN_MODE 也认（本项优先）；debug 会往 stdout 打中间件提示，
# 默认 release 保证 stdout 上只有启动横幅。
MCPHUB_GIN_MODE=release

# 管理接口鉴权密钥。留空则不校验，仅建议监听 127.0.0.1 时留空。
# MCPHUB_API_KEY=

# ─── Embedding（工具检索的向量一路）───────────────────────────
# 硅基流动兼容 OpenAI 的 /v1/embeddings。换服务商只改 BASE_URL。
MCPHUB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
MCPHUB_EMBED_MODEL=BAAI/bge-m3

# 向量维度，必须与模型真实输出的维度一致。
# 填错不会当场报错，但写库前的维度校验会拦住 —— 放过的话检索会
# 静默降级成 bm25，现象只是"搜索变差了"。
MCPHUB_EMBED_DIMS=1024

# 每批送多少条文本给 embed 接口
MCPHUB_EMBED_BATCH_SIZE=64

# 哪些字段进向量语料，逗号分隔；all（或不写）表示五项全开。
# 可选：toolName / toolDescription / tags / serverDescription / schemaHints
# 它和 MODEL、DIMS 一起构成"一代"向量的身份：改了会触发整代重建。
MCPHUB_CORPUS_FIELDS=all

# 密钥。留空则检索自动降级为 keyword/bm25，网关照常运行。
MCPHUB_EMBED_API_KEY=

# ─── Reranker（hybrid 检索的精排一路）─────────────────────────
# 留空 MCPHUB_RERANK_MODEL 即关闭精排，hybrid 返回 RRF 融合排序结果。
MCPHUB_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 与 embed 同源时这两项可以省掉（自动复用上面的地址与密钥）；
# 换两家服务商时才需要单独指定。
# MCPHUB_RERANK_BASE_URL=
# MCPHUB_RERANK_API_KEY=
